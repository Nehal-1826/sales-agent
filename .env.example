# ============================================================
# WarmPulse environment — copy to .env and fill real values
# ============================================================

# --- Database ---
POSTGRES_USER=warmpulse
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=warmpulse_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://warmpulse:change_me_dev_only@localhost:5432/warmpulse_db

# --- Redis (shared with SashaLMS; WarmPulse uses prefix warmpulse:*) ---
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=warmpulse

# --- Security ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace_me_generate_with_fernet_generate_key
# JWT: exactly ONE secret is documented in this file — WARMUP_JWT_SECRET in
# the Docker compose section below. Compose maps it into the FastAPI
# services as their JWT_SECRET, so there is no second key to drift/rotate.
# (FastAPI LOCAL dev outside docker sets its own JWT_SECRET in backend/.env
# — see backend/.env.example. Not set here.)
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Docker compose (root docker-compose.yml) ---
# THE secret compose actually interpolates (${WARMUP_JWT_SECRET}): it feeds
# the FastAPI JWT_SECRET (api/worker/beat services) AND Django's
# WARMUP_JWT_SECRET (the JWT bridge) — one value signs both sides. 32+ chars
# required in production; Django refuses to mint bridge tokens with shorter.
WARMUP_JWT_SECRET=replace_me_random_64_bytes
# Bridge kill-switch on the FastAPI side (goes in backend/.env.docker):
# default on; set false to hard-disable bridge logins.
# AGENT_BRIDGE_ENABLED=false
# The Database section's POSTGRES_USER/PASSWORD/DB above feed the compose db
# service and both API URLs. Postgres holds TWO databases:
#   warmpulse_db = FastAPI, agent = Django (ops/db/init-agent-db.sql).

# --- Django backend-agent (compose `django` service; env_file: .env) ---
# With DJANGO_DEBUG=0 the app refuses to start unless DJANGO_SECRET_KEY and
# ALLOWED_HOSTS are set to real values — fill both before first boot.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-generate-a-64-char-key
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.example
# First-boot owner account (manage.py bootstrap_admin); blank ADMIN_PASSWORD
# (compose default) is auto-generated and printed in container logs.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
# Demo installs seed operator / operator-demo-2026. Uncomment for demos only.
# SEED_DEMO=1
# Needed once HTTPS lands (admin login behind TLS): scheme + host, no trailing
# slash, comma separated for several domains.
# CSRF_TRUSTED_ORIGINS=https://your-domain.example

# --- HTTPS overlay (docker-compose.https.yml — Caddy TLS termination) -------
# Only needed when running the optional overlay:
#   docker compose -f docker-compose.yml -f docker-compose.https.yml up -d
# DOMAIN: DNS A record must point at the VPS first (cert is issued for it).
# ACME_EMAIL: Let's Encrypt expiry-notice address.
# DOMAIN=your-domain.example
# ACME_EMAIL=you@example.com

# --- Google OAuth (mailbox-connect only; reuses SashaLMS client per CLAUDE.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback

# Placeholder pricing — see spec §13 open question #1. USD per 1,000 tokens.

# --- Claude fallback (optional) ---
ANTHROPIC_API_KEY=

# --- Gemini (Google Generative Language API — primary LLM if set) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_PRICE_PER_1K_TOKENS_USD=0.00015

# --- App ---
APP_ENV=development
APP_BASE_URL=http://localhost:8001
FRONTEND_BASE_URL=http://localhost:5173
LOG_LEVEL=INFO

# --- Julex integration (store-builder platform) ---
# Public API base used to verify merchant store keys (x-store-key header).
# JULEX_ORIGIN is added to CORS so Julex's frontend can poll the status endpoint.
JULEX_BASE_URL=https://julex.shop
JULEX_ORIGIN=https://julex.shop

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
