# ============================================================
# WarmPulse environment — copy to .env and fill real values
# ============================================================

# --- Database ---
POSTGRES_USER=warmpulse
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=warmpulse_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://warmpulse:change_me_dev_only@localhost:5432/warmpulse_db

# --- Redis (shared with SashaLMS; WarmPulse uses prefix warmpulse:*) ---
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=warmpulse

# --- Security ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace_me_generate_with_fernet_generate_key
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace_me_random_64_bytes
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Docker compose (root docker-compose.yml) ---
# One secret, two names: compose maps WARMUP_JWT_SECRET into FastAPI's
# JWT_SECRET and Django's WARMUP_JWT_SECRET (the JWT bridge). Use the SAME
# value as JWT_SECRET above so tokens issued by one side verify on the other.
WARMUP_JWT_SECRET=replace_me_random_64_bytes
# The Database section's POSTGRES_USER/PASSWORD/DB above feed the compose db
# service and both API URLs. Postgres holds TWO databases:
#   warmpulse_db = FastAPI, agent = Django (ops/db/init-agent-db.sql).

# --- Google OAuth (mailbox-connect only; reuses SashaLMS client per CLAUDE.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback

# Placeholder pricing — see spec §13 open question #1. USD per 1,000 tokens.

# --- Claude fallback (optional) ---
ANTHROPIC_API_KEY=

# --- Gemini (Google Generative Language API — primary LLM if set) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_PRICE_PER_1K_TOKENS_USD=0.00015

# --- App ---
APP_ENV=development
APP_BASE_URL=http://localhost:8001
FRONTEND_BASE_URL=http://localhost:5173
LOG_LEVEL=INFO

# --- Julex integration (store-builder platform) ---
# Public API base used to verify merchant store keys (x-store-key header).
# JULEX_ORIGIN is added to CORS so Julex's frontend can poll the status endpoint.
JULEX_BASE_URL=https://julex.shop
JULEX_ORIGIN=https://julex.shop

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
