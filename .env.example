# ------------------------------------------------------------------
# Shailog Marketing & Sales AI — VPS environment.
# Copy to .env and fill in the values:  cp .env.example .env && nano .env
# ------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(50))"
# REQUIRED in production (DJANGO_DEBUG=0) — the app refuses to start without it.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0

# Your VPS IP and/or domain(s), comma separated. The browser talks to nginx,
# but Django also sees the Host header — list both forms:
#   ALLOWED_HOSTS=11.22.33.44,yourdomain.com
# REQUIRED in production — the app refuses to start on '*'.
ALLOWED_HOSTS=

# Force https:// redirects (only when serving over HTTPS with a domain):
# SECURE_SSL_REDIRECT=1

# Needed for the Django admin login form when served over HTTPS:
#   CSRF_TRUSTED_ORIGINS=https://yourdomain.com
CSRF_TRUSTED_ORIGINS=

# Extra browser origins allowed to call the API (only needed if you host the
# frontend on a different domain than the API — the default nginx setup is
# same-origin and needs nothing here):
#   CORS_ALLOWED_ORIGINS=https://yourdomain.com
CORS_ALLOWED_ORIGINS=

# --- AI provider (LLM: vetting, descriptions, copywriting, chat, guide) -----
# Any OpenAI-compatible provider works; Gemini is the tested default.
# Can also be set later in Settings → AI Key (DB stays the source of truth;
# these env vars only fill EMPTY db fields once).
AI_PROVIDER=Gemini
AI_KEY=your-gemini-or-openai-compatible-api-key

# --- Phone enrichment chain (all optional — each source is skipped when blank)
# Pipeline order per lead: site scrape → Scalelist → Apollo → Google Maps.
#   1) Scalelist person/company phone find     https://scalelist.com
SCALELIST_API_KEY=
#   2) Apollo.io organization enrich           https://apollo.io
APOLLO_API_KEY=
#   3) Apify "compass/google-maps-extractor"   https://apify.com
#      Pay-per-event actor; India leads are searched first.
APIFY_API_KEY=

# --- First boot (product mode) ----------------------------------------------
# SEED_DEMO=0 (default, product): no demo users, no sample leads. The
#   container creates ONE workspace owner from the ADMIN_* values below and
#   prints a generated password in `docker compose logs api` if you leave it
#   blank — change it right after first login.
# SEED_DEMO=1 (demo/sales-floor mode): seeds the demo experience
#   (login operator / operator-demo-2026 + sample CRM data).
SEED_DEMO=0
ADMIN_USERNAME=admin
ADMIN_EMAIL=
# ADMIN_PASSWORD=          # leave blank to auto-generate a strong one

# --- Postgres (used by docker-compose; keep in sync) -----------------------
POSTGRES_DB=agentic
POSTGRES_USER=agentic
POSTGRES_PASSWORD=change-me-too

# --- SMTP for outreach + the daily 8 PM IST report --------------------------
# (These can also be set in the Django admin UI; env is the server-side way.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# FROM_EMAIL=you@gmail.com
# REPORT_EMAIL=you@gmail.com
