# Normalize line endings repo-wide — mixed CRLF/LF between Windows and Linux
# contributors creates phantom diffs and merge conflicts. Everyone gets LF.
* text=auto eol=lf

# Windows scripts keep CRLF (they break with LF in some shells)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries — never diff/merge/normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webm binary
*.mp4 binary
*.woff binary
*.woff2 binary
