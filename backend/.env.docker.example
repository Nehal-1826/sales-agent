# App
# APP_BASE_URL carries the EXTERNAL prefix: the gateway routes /wp-api/x →
# FastAPI /x, so API-style absolute URLs need /wp-api/api (not /api).
APP_ENV=production
APP_BASE_URL=https://YOUR_DOMAIN/wp-api/api
FRONTEND_BASE_URL=https://YOUR_DOMAIN
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg://warmpulse:warmpulse@127.0.0.1:5433/warmpulse_db

# Redis
REDIS_URL=redis://127.0.0.1:6380/0
REDIS_KEY_PREFIX=warmpulse:

# Celery
CELERY_BROKER_URL=redis://127.0.0.1:6380/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/1

# Crypto — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=GENERATE_ME

# JWT — under docker compose this line is OVERRIDDEN: the root .env's
# WARMUP_JWT_SECRET is mapped in as the FastAPI JWT_SECRET (one bridge
# secret, no double entry). GENERATE_ME is a blocklisted placeholder — the
# app refuses it in production, so never run bare (outside compose) with it.
JWT_SECRET=GENERATE_ME
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Google OAuth (mailbox-connect) — external /wp-api prefix, same as APP_BASE_URL
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/wp-api/api/auth/google/callback
GOOGLE_MAILBOX_REDIRECT_URI=https://YOUR_DOMAIN/wp-api/api/auth/google/mailbox-callback


# Firebase (for Google sign-in)
FIREBASE_PROJECT_ID=
