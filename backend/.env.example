# App
APP_ENV=development
APP_BASE_URL=http://localhost:8001
FRONTEND_BASE_URL=http://localhost:5173
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg://warmpulse:warmpulse@localhost:5432/warmpulse_db

# Redis (key-prefixed on the shared SashaLMS instance in prod)
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=warmpulse:

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Crypto
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=changeme-generate-a-real-fernet-key

# JWT
JWT_SECRET=changeme-use-a-long-random-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Google OAuth (mailbox-connect only; reuses SashaLMS client in prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback

